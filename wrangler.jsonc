{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-best-body",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/auth/*", "/dev/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "my-best-body-db", "database_id": "3ab448b3-1ec2-469b-9697-00c30785da22", "migrations_dir": "migrations" }
  ],
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "VAPID_PUBLIC_KEY": "BO2ocI9p5iNF0iEPcXV1XHa7ls3ovbvCAN5DdB3kKBaaT-fGuXW7iCWrb-9ZQhzujY-xjm6MPW0k4VJkfktc5K0",
    "VAPID_SUBJECT": "https://github.com/jqsmine1999-dotcom/my-best-body/issues"
  }
}
