{
  "name": "my-best-body",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply my-best-body-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply my-best-body-db --remote",
    "test": "playwright test",
    "deploy": "wrangler d1 migrations apply my-best-body-db --remote && wrangler deploy",
    "icons": "node scripts/make-icons.mjs",
    "demo": "node scripts/record-demo.mjs",
    "ai-eval": "node scripts/ai-eval.mjs",
    "test:prod": "playwright test -c playwright.prod.config.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@playwright/test": "^1.64.1",
    "ffmpeg-static": "^5.3.0",
    "hono": "^4.13.14",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.0"
  }
}
